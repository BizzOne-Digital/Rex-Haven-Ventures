# ============================================================
# REX HAVEN VENTURES — Environment Configuration
# ------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values:
#     cp .env.example .env.local
#
# Every `.env*` file is git-ignored except this example.
# Never commit real credentials.
# ============================================================


# ============================================================
# REQUIRED
# ============================================================

# ---- Database ----------------------------------------------
# MongoDB connection string. Server-side only — never exposed
# to the browser (no NEXT_PUBLIC_ prefix).
#
# Local:  mongodb://127.0.0.1:27017/rex-haven
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rex-haven?retryWrites=true&w=majority
#
# The database name is the path segment after the host
# ("rex-haven" above). Create the user in Atlas under
# Database Access with "Read and write to any database".
MONGODB_URI=


# ---- Session signing ---------------------------------------
# Secret used to sign the HttpOnly session cookie (JWT, HS256).
# MUST be at least 32 characters. Generate one with:
#     openssl rand -base64 32
#
# Use a DIFFERENT value in production than in development.
# Changing this invalidates every existing session, signing
# all members and admins out.
AUTH_SECRET=


# ---- Administrator account ---------------------------------
# The administrator is created in MongoDB the first time
# someone signs in at /admin/login with these credentials.
# ADMIN_PASSWORD is bcrypt-hashed before storage — the plain
# value is never written to the database.
#
# ADMIN_EMAIL     the address you will sign in with
# ADMIN_PASSWORD  at least 8 characters, with a letter and a number
#
# Note: the seed CREATES the account; it does not overwrite an
# existing one. After first run, change the password from
# Profile & Settings in the dashboard, not here. To reset a
# forgotten password, delete that user document (or point
# ADMIN_EMAIL at a new address) and sign in again.
ADMIN_EMAIL=
ADMIN_PASSWORD=


# ---- Public app URL ----------------------------------------
# Absolute base URL of this deployment, no trailing slash.
# Used for canonical links, metadata, and absolute URLs.
#
# Local:      http://localhost:3000
# Production: https://www.rexhavenventures.com
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ============================================================
# OPTIONAL
# ============================================================

# ---- Canonical site URL ------------------------------------
# Pre-existing variable consumed by lib/site.ts for SEO
# metadata. Defaults to https://www.rexhavenventures.com.
# Usually the same value as NEXT_PUBLIC_APP_URL.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ---- Session lifetime --------------------------------------
# How long a member stays signed in, in days. Default: 7.
# SESSION_MAX_AGE_DAYS=7


# ---- Administrator display name ----------------------------
# Shown in the dashboard for the seeded admin.
# Default: "Administrator". Editable later in the UI.
# ADMIN_NAME=


# ---- Contact form delivery ---------------------------------
# Pre-existing feature (app/api/contact). Configure ONE option,
# or leave all blank — the contact form then reports honestly
# that delivery is not configured instead of faking success.
#
# Option A — POST the submission JSON to a webhook
# (Zapier / Make / n8n). Paste the webhook URL:
# CONTACT_WEBHOOK_URL=
#
# Option B — send email via Resend (all three required).
# RESEND_API_KEY   from resend.com/api-keys
# CONTACT_TO_EMAIL where enquiries should arrive
# CONTACT_FROM_EMAIL an address on a domain verified in Resend
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=


# ============================================================
# MEDIA STORAGE
# ============================================================
# Admin image uploads go to Cloudinary when all three
# CLOUDINARY_* values below are set, and to `public/uploads` on
# the server's own filesystem when they are not. No code change
# is needed to switch — `lib/media.ts` picks the back end from
# the environment, and each image records which one holds it, so
# both can coexist.
#
# Local files need no configuration and work on any Node host,
# but they do NOT survive a deploy on a platform with an
# ephemeral or read-only filesystem (Vercel, Netlify Functions).
# Configure Cloudinary before going live on one of those.

# ---- Cloudinary (implemented) ------------------------------
# From your Cloudinary dashboard (cloudinary.com/console),
# under "API Keys".
#
# CLOUDINARY_API_SECRET is server-side only — never give it a
# NEXT_PUBLIC_ prefix, and never commit a real value.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Folder new uploads are filed under. Default: rex-haven
# CLOUDINARY_UPLOAD_FOLDER=rex-haven

# ---- S3-compatible storage (not implemented) ---------------
# AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces.
# Documented so you know what to obtain; adopting it means
# adding a third `provider` branch in lib/media.ts.
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=
